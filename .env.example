# Copy to .env.local and fill in before building for production.

# WhatsApp business number in international format, digits only (no "+", spaces or dashes).
# Mauritius example format: 230XXXXXXXX. Must be the verified Nova business number.
VITE_WHATSAPP_NUMBER=

# Production origin, e.g. https://example.com (no trailing slash). When set, the build adds a
# canonical URL, absolute social-image URLs, sitemap.xml and a Sitemap line in robots.txt.
SITE_URL=
